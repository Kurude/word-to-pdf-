{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "word2pdf",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "containers": [
    {
      "class_name": "Word2PdfContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORD2PDF_CONTAINER",
        "class_name": "Word2PdfContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Word2PdfContainer"]
    }
  ]
}
